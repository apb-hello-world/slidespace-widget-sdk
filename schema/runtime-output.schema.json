{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {},
    "values": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "commands": {
      "default": [],
      "maxItems": 16,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "refresh"
              },
              "dataSource": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "openLink"
              },
              "url": {
                "type": "string",
                "maxLength": 2000,
                "format": "uri"
              }
            },
            "required": [
              "type",
              "url"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "mediaControl"
              },
              "command": {
                "type": "string",
                "enum": [
                  "playPause",
                  "previous",
                  "next"
                ]
              }
            },
            "required": [
              "type",
              "command"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "values",
    "commands"
  ],
  "additionalProperties": false
}